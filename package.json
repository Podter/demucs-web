{
  "name": "demucs-web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun -b astro dev",
    "build": "bun -b astro build",
    "preview": "bun -b astro preview",
    "lint": "bun -b prettier --check . && bun -b eslint .",
    "format": "bun -b prettier --write .",
    "docker:up": "docker compose -f compose-dev.yml up -d",
    "docker:down": "docker compose -f compose-dev.yml down",
    "docker:rm": "docker compose -f compose-dev.yml down -v --remove-orphans"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tabler/icons-react": "^3.40.0",
    "astro": "^5.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/node": "^9.5.4",
    "@astrojs/react": "^4.4.2",
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "^1.3.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro-eslint-parser": "^1.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript-eslint": "^8.56.1"
  }
}

---
import { IconBrandGithub, IconHeart } from "@tabler/icons-react";
---

<footer class="fixed bottom-0 z-50 flex w-full justify-center">
  <div
    class="container flex w-full flex-col items-center justify-between space-y-1 border-t py-3.5 sm:flex-row"
  >
    <a
      class="text-muted-foreground flex items-center space-x-1.5 text-sm font-medium transition-opacity hover:opacity-80"
      href="https://podter.me"
    >
      <IconHeart size={12} />
      <span>Made by Podter</span>
    </a>
    <a
      class="text-muted-foreground flex items-center space-x-1.5 text-sm font-medium transition-opacity hover:opacity-80"
      href="https://github.com/Podter/compress.podter.me"
    >
      <IconBrandGithub className="inline" size={12} />
      <span>Source code</span>
    </a>
  </div>
</footer>
